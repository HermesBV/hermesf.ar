{"title":"","markdown":{"yaml":{"title":" ","pagetitle":"CV — Hermes Fernández"},"containsRefs":false,"markdown":"\n\n```{=html}\n<!-- Índice tipo Wikipedia (flota a la derecha) -->\n<div class=\"cv-toc\">\n  <div class=\"toc-title\">Contenido</div>\n  <ol>\n    <li><a href=\"#experiencia-laboral\">Experiencia laboral</a></li>\n    <li><a href=\"#formacion-academica\">Formación académica</a></li>\n    <li><a href=\"#eventos-academicos\">Eventos académicos</a></li>\n    <li><a href=\"#habilidades-tecnicas\">Habilidades técnicas</a></li>\n    <li><a href=\"#idiomas\">Idiomas</a></li>\n  </ol>\n</div>\n\n<!-- Cabecera del CV -->\n<div class=\"cv-header\">\n  <h1>Hermes Fernández</h1>\n  <div class=\"cv-subtitle\"><strong>Sociología · Economía · Datos</strong></div>\n  <div class=\"cv-meta\">\n    Ciudad de Buenos Aires<br>\n    <a href=\"mailto:hermesbv21@gmail.com\">hermesbv21@gmail.com</a> · +54 9 11 6288-2108<br>\n    <a href=\"https://www.linkedin.com/in/hermes-fernandez/\" target=\"_blank\">linkedin.com/in/hermes-fernandez</a> ·\n    <a href=\"https://github.com/HermesBV/\" target=\"_blank\">github.com/HermesBV</a>\n  </div>\n</div>\n\n<!-- EXPERIENCIA LABORAL -->\n<div class=\"cv-section\" id=\"experiencia-laboral\">\n  <h2>1. Experiencia laboral</h2>\n\n  <div class=\"cv-entry\">\n    <div class=\"entry-title\">Coordinador de Datos del Área Macro</div>\n    <div class=\"entry-org\">IIEP · FCE-UBA</div>\n    <div class=\"entry-period\">Abril 2026 – actualidad</div>\n    <div class=\"entry-desc\">Soporte y desarrollo de la web app Series Macro y bases de datos.</div>\n  </div>\n\n  <div class=\"cv-entry\">\n    <div class=\"entry-title\">Docente Ayudante</div>\n    <div class=\"entry-org\">Lic. en Economía · FCE-UBA</div>\n    <div class=\"entry-period\">2025 – actualidad</div>\n    <div class=\"entry-desc\">\"Tópicos de Macroeconomía Avanzada\" — Dr. Pablo Mira.</div>\n  </div>\n\n  <div class=\"cv-entry\">\n    <div class=\"entry-title\">Becario Estímulo UBACyT<